{
  "name": "less-lazy",
  "version": "1.0.0",
  "description": "Background prefetching for React.lazy: lazy-loaded pages render instantly, no Suspense flash",
  "keywords": [
    "react",
    "lazy",
    "prefetch",
    "preload",
    "suspense",
    "code-splitting",
    "vite"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./app.js"
    }
  },
  "main": "app.js",
  "types": "index.d.ts",
  "files": [
    "app.js",
    "index.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actuallymentor/less-lazy.git"
  },
  "author": "Mentor <mentor@palokaj.co> (http://github.com/actuallymentor)",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "mentie": "^0.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
